# Browser-safe Supabase configuration. The publishable key is intentionally
# exposed to the client; authorization is enforced by Postgres RLS policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration. Never expose these through VITE_* variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# Server-only. Never expose these values through VITE_* variables.
OPENAI_API_KEY=
BUSINESS_PLAN_AI_ENABLED=true
BUSINESS_PLAN_AI_MODEL=gpt-4.1-mini
BUSINESS_PLAN_AI_TIMEOUT_MS=30000
BUSINESS_PLAN_AI_MAX_INPUT_CHARACTERS=24000
BUSINESS_PLAN_AI_MAX_REGENERATIONS=2
BUSINESS_PLAN_AI_MAX_PLAN_GENERATIONS=36
BUSINESS_PLAN_AI_MAX_USER_DAILY_CALLS=50

# Server-only Stripe configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_COMPLETE_PLAN_PRICE_ID=
APP_BASE_URL=http://localhost:5173
